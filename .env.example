GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ENABLE_DIALOGPT_FALLBACK=true

# TF-IDF RAG works without model downloads; semantic needs optional dependencies.
RAG_BACKEND=tfidf

# Default VADER needs little RAM; set to roberta only after installing
# requirements-sentiment-experiment.txt (first use downloads ~500 MB weights).
SENTIMENT_BACKEND=vader
