GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ENABLE_DIALOGPT_FALLBACK=true

# Document RAG: run python ingest_documents.py after installing RAG dependencies.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_MIN_SIMILARITY=0.30

# Default VADER needs little RAM; set to roberta only after installing
# requirements-sentiment-experiment.txt (first use downloads ~500 MB weights).
SENTIMENT_BACKEND=vader
